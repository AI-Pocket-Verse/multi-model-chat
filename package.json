{
  "name": "multi-model-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Send one prompt to many LLMs side by side, with streaming replies and text-to-image comparison",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "bootstrap": "node -e \"const fs=require('fs');if(!fs.existsSync('api/.env.dev')){fs.copyFileSync('api/.env.example','api/.env.dev');console.log('Created api/.env.dev from api/.env.example')}\"",
    "dev": "pnpm bootstrap && pnpm --parallel --filter @multi-model-chat/api --filter @multi-model-chat/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "screenshots": "node scripts/demo-media.mjs screenshots",
    "demo-video": "node scripts/demo-media.mjs video",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.5",
      "esbuild": ">=0.25.0 <0.26",
      "vitest": "4.1.12",
      "micromatch": ">=4.0.8",
      "@fastify/static>glob": "14.0.3"
    }
  }
}
