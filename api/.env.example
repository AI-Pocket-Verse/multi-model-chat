# multi-model-chat API — copied to api/.env.dev on the first `pnpm dev`.
# For a server, copy it to api/.env.prod and set NODE_ENV=production.
# Loaded via Node's native --env-file= flag. Never commit the copies.
# (No inline comments: older Node versions would read them as part of the value.)
NODE_ENV=development
PORT=4060
# Local mode has no login: keep 127.0.0.1 unless you also set WHOAMI_URL below,
# otherwise anyone who can reach this port can spend your API keys.
HOST=127.0.0.1
# Reverse proxies whose X-Forwarded-For is trusted (Fastify trustProxy), so the
# rate limit buckets by the real client IP. Default loopback = same-host nginx.
# Use IPs / CIDRs; hop counts are rejected. Never set it to true: any client
# could then spoof its IP.
# TRUST_PROXY=loopback

# Optional login. Leave unset for local single-user mode (no login at all).
# To require Feishu login, deploy the companion feishu-sso service and point
# this at its whoami endpoint (web must also set VITE_SSO_BASE, see README).
# WHOAMI_URL=http://127.0.0.1:4020/api/whoami

# Local mode only accepts requests whose Host is localhost / 127.0.0.1 / ::1
# (blocks DNS-rebinding attacks from malicious web pages). Add the domain or
# LAN IP you use to open the app, comma separated.
# ALLOWED_HOSTS=chat.example.com,192.168.1.10

# CORS — leave empty when web and api share one origin (vite proxy / nginx).
CORS_ORIGINS=

# Serve the built web app (web/dist) from the api itself. Used by the Docker
# image; leave unset when nginx serves the static files.
# WEB_DIST_DIR=../web/dist

# Provider API keys — server side only, the browser never sees them.
# Leave a provider empty to only allow models that carry their own key.
# Volcengine Ark (Doubao)
ARK_API_KEY=
# Alibaba Cloud Model Studio (Qwen)
QWEN_API_KEY=
DEEPSEEK_API_KEY=
# Zhipu (GLM)
ZHIPU_API_KEY=
# Moonshot (Kimi)
KIMI_API_KEY=
MINIMAX_API_KEY=

# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Ollama, vLLM, LM Studio...
# Point it at the /v1 level, e.g. https://api.openai.com/v1 or
# http://127.0.0.1:11434/v1 (Ollama, no key needed).
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Whether the browser may enter its own Base URL for custom models. Empty =
# allowed in local mode, forbidden once WHOAMI_URL login is on (on a shared
# server an arbitrary URL lets users reach your internal network, i.e. SSRF).
# The server's CUSTOM_API_KEY is never sent to a browser-supplied URL.
# ALLOW_USER_BASE_URL=
