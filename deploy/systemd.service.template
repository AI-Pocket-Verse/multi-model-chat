[Unit]
Description=multi-model-chat API
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__/api
EnvironmentFile=__INSTALL_DIR__/api/.env.prod
# 内部包（packages/*、shared）以 TS 源码形式被引用，需要 tsx 加载器才能运行
ExecStart=/usr/bin/node --import tsx __INSTALL_DIR__/api/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
